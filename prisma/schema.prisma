// Schéma Prisma — JJK Arcade (Neon Postgres).
//
// Workflow : pas de migrations, on synchronise le schéma avec la base via
//   npx prisma db push        (applique le schéma à Neon)
//   npx prisma generate       (régénère le client typé)
//
// DATABASE_URL est défini dans .env (voir .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rôle d'un utilisateur. PLAYER par défaut ; ADMIN donne accès à /admin.
/// VIP : joueur privilégié — peut rejouer JJKdle un nombre limité de fois par
/// jour (cf. VIP_MAX_REPLAYS), sans accès à l'admin.
enum Role {
  PLAYER
  VIP
  ADMIN
}

/// Compte utilisateur. Le jeu se joue sans compte ; le compte sert au
/// leaderboard (enregistrement des scores) et, pour les ADMIN, à l'édition du roster.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())

  // Customisation profil (bannière, avatar, titre/cadre équipés, layout) ET
  // streak quotidien JJKdle sont désormais PAR UNIVERS → cf. UserUniverseProfile
  // (étape 2c). Le compte ne porte plus que l'identité et la progression globale.

  // ── Progression GLOBALE (cache recalculé en fin de partie ; source = scores) ──
  totalXp Int @default(0)
  xpBonus Int @default(0) // ajustement manuel admin (additif, persistant)
  level   Int @default(1)

  sessions     Session[]
  scores       Score[]
  lobbyPlayers LobbyPlayer[]
  draftScores  JujutsuDraftScore[]
  jjkdleScores JjkdleScore[]
  higherLowerScores HigherLowerScore[]
  guessWhoScores GuessWhoScore[]
  codenamesScores CodenamesScore[]
  badges       UserBadge[]
  titleGrants  UserTitleGrant[]
  frameGrants  UserFrameGrant[]
  jjkdleResults JjkdleResult[]
  universeProfiles UserUniverseProfile[]
}

/// Profil PAR UNIVERS d'un utilisateur (étape 2c). Le compte reste global
/// (identité, XP, niveau, possession des cosmétiques) ; en revanche ce qui est
/// ÉQUIPÉ (titre/cadre/bannière/avatar/layout) et le STREAK quotidien sont
/// propres à chaque univers. Une ligne par couple utilisateur/univers.
model UserUniverseProfile {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id])

  // ── Loadout équipé (déplacé de User) ──
  equippedTitleKey  String?
  equippedFrameKey  String?
  bannerKey         String     @default("default")
  avatarCharacterId String?
  avatarCharacter   Character? @relation("UserUniverseAvatar", fields: [avatarCharacterId], references: [id], onDelete: SetNull)
  profileLayout     Json?

  // ── Streak daily (déplacé de User — décision : streak par univers) ──
  jjkdleStreak       Int     @default(0)
  jjkdleBestStreak   Int     @default(0)
  jjkdleLastPlayedAt String?

  @@unique([userId, universeId])
  @@index([universeId])
}

/// Déblocage d'un badge par un utilisateur. La métadonnée du badge (nom,
/// description, icône, règle) vit dans le code (lib/badges/definitions.ts) ;
/// seule la possession est persistée. `badgeKey` réfère une clé de BADGES.
model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey   String
  unlockedAt DateTime @default(now())
  /// Id de l'admin ayant octroyé MANUELLEMENT le badge. null = débloqué par règle
  /// dérivée (cf. lib/badges/evaluate). Sert à tracer l'origine, sans changer la
  /// logique : un badge dérivé encore mérité se re-débloque même après retrait.
  grantedBy  String?

  @@unique([userId, badgeKey])
  @@index([userId])
}

/// Octroi MANUEL d'un titre par un admin (cf. §5). Séparé du déblocage dérivé
/// (lib/cosmetics/unlock) pour pouvoir l'accorder/retirer sans toucher aux stats.
/// `titleKey` réfère une clé de TITLES (lib/titles/definitions.ts). Un titre est
/// considéré débloqué si la règle dérivée est vraie OU un grant existe OU admin.
model UserTitleGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleKey  String
  grantedBy String // id de l'admin ayant octroyé
  grantedAt DateTime @default(now())

  @@unique([userId, titleKey])
  @@index([userId])
}

/// Octroi MANUEL d'un cadre par un admin (cf. §5). Même logique que
/// UserTitleGrant. `frameKey` réfère une clé de FRAMES (lib/frames/definitions.ts).
model UserFrameGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frameKey  String
  grantedBy String
  grantedAt DateTime @default(now())

  @@unique([userId, frameKey])
  @@index([userId])
}

/// Session d'authentification (token aléatoire stocké en cookie httpOnly).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Issue d'une partie de Jujutsu Draft.
enum DraftOutcome {
  VICTORY
  DEFEAT
}

/// Meilleur score de Jujutsu Draft d'un utilisateur (un enregistrement par
/// utilisateur — upsert quand un meilleur résultat est obtenu). `globalScore`
/// est le score global caché recalculé côté serveur (anti-triche) ; `draft`
/// est le snapshot des persos choisis par catégorie au moment du record.
model JujutsuDraftScore {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enemiesKilled Int
  globalScore   Int
  outcome       DraftOutcome
  draft         Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Multi-univers (étape 2b). Un meilleur score par joueur ET par univers.
  universeId String

  @@unique([userId, universeId])
  @@index([universeId, enemiesKilled, globalScore])
}

/// Score JJKdle : nombre d'essais d'un utilisateur pour le perso mystère d'un
/// JOUR donné (un enregistrement par couple utilisateur/date). Le classement
/// quotidien se lit en filtrant sur la date du jour (`date` = "YYYY-MM-DD") et
/// se classe par `attempts` croissant (moins d'essais = meilleur). Les entrées
/// des jours passés restent en base mais ne sont plus affichées → reset quotidien.
/// Seules les parties en mode "daily" (perso commun) sont enregistrées ; les
/// parties bonus admin/VIP (perso aléatoire) ne comptent pas.
model JjkdleScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  attempts  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-univers (étape 2b). Le daily étant PAR univers, universeId entre dans
  // la clé d'unicité (un score par joueur, par univers, par jour).
  universeId String

  @@unique([userId, universeId, date])
  @@index([universeId, date, attempts])
}

/// Résultat ANALYTIQUE d'une partie JJKdle QUOTIDIENNE, par utilisateur connecté.
/// Distinct de `JjkdleScore` (classement, victoires uniquement) : on garde ICI le
/// `targetId` (perso du jour) et le flag `solved` pour calculer les stats admin
/// (taux de réussite, taux d'abandon, personnage le plus raté).
/// Cycle : upsert au 1er essai (solved=false, attempts=1), mis à jour à chaque essai,
/// puis solved=true à la victoire. Une ligne par couple utilisateur/date.
/// Les parties anonymes (sans compte) ne sont PAS enregistrées (pas d'userId).
model JjkdleResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId  String // perso du jour
  date      String // "YYYY-MM-DD" (todayKey, Europe/Paris)
  attempts  Int // nb d'essais utilisés à date
  solved    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-univers (étape 2b). Daily par univers → unicité par joueur/univers/jour.
  universeId String

  @@unique([userId, universeId, date])
  @@index([universeId, date])
  @@index([targetId])
}

/// Configuration globale clé/valeur (feature flags, mode maintenance, override du
/// mot du jour JJKdle). Lue partout dans l'app via `getConfig` (lib/config/app-config.ts),
/// écrite depuis /admin. `value` est un blob JSON typé côté code selon la clé.
model AppConfig {
  key   String @id
  value Json
}

/// Score d'une partie de « JJK Higher/Lower » — une ligne PAR PARTIE terminée
/// (append, pas d'upsert). `score` = nombre de bonnes réponses ; `xpEarned` = XP
/// octroyée pour cette partie (persistée pour l'affichage ; l'XP totale reste
/// agrégée sur User.totalXp via awardExp). Le classement se lit best-par-joueur
/// (DISTINCT ON userId, cf. lib/games/higher-lower/store.ts).
model HigherLowerScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  xpEarned  Int
  createdAt DateTime @default(now())

  // Multi-univers (étape 2b).
  universeId String

  @@index([userId])
  @@index([universeId, score])
}

/// État autoritatif d'une partie « Higher/Lower » EN COURS (anti-triche).
/// Éphémère : créée au démarrage, supprimée en fin de partie. `id` = runId
/// référencé par le cookie httpOnly `hl_run`. `userId` nullable → jouable sans
/// compte. `rightCursedEnergy` = valeur cachée du perso de droite, JAMAIS exposée
/// au client tant qu'il n'a pas répondu. `usedIds` = persos déjà apparus (évite la
/// répétition immédiate à droite).
model HigherLowerSession {
  id                String   @id @default(cuid())
  userId            String?
  score             Int      @default(0)
  leftId            String
  leftCursedEnergy  Int
  rightId           String
  rightCursedEnergy Int
  usedIds           String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Multi-univers (étape 2e). Colonne scalaire (pas de FK) : table éphémère à
  // fort churn, même convention que les tables de score. Une session démarrée
  // dans un univers ne peut pas être reprise depuis un autre.
  universeId String

  @@index([userId])
}

/// Partie « Qui est-ce ? » (Guess Who JJK) — état autoritatif d'un 1v1 en cours.
/// Réutilise le lobby/présence Pusher (Lobby via lobbyId). Les DEUX secrets vivent
/// ICI et ne sont JAMAIS sérialisés vers le client tant que la partie est ACTIVE
/// (anti-triche) : chaque joueur ne récupère que le sien via une Server Action
/// authentifiée. La grille (25 IDs) est partagée/identique pour les deux joueurs ;
/// seuls les secrets diffèrent. Les éliminations sont locales/privées (non persistées).
model GuessWhoGame {
  id          String   @id @default(cuid())
  lobbyId     String   @unique
  player1Id   String
  player2Id   String
  gridCharIds String[] // 25 IDs, ordre partagé
  secret1Id   String // secret que player2 doit deviner (= perso secret de player1)
  secret2Id   String // secret que player1 doit deviner (= perso secret de player2)
  currentTurn String // userId dont c'est le tour
  status      String   @default("ACTIVE") // ACTIVE | FINISHED
  winnerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-univers (étape 2e). La partie n'est atteignable qu'via son lobby (déjà
  // filtré par univers), mais on tagge quand même : défense en profondeur +
  // statistiques admin par univers.
  universeId String

  @@index([lobbyId])
}

/// Résultat d'une partie « Qui est-ce ? » — une ligne PAR joueur ET PAR partie
/// terminée (append). `won` = ce joueur a gagné. Le ratio V/D se lit par agrégation.
model GuessWhoScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  won       Boolean
  createdAt DateTime @default(now())

  // Multi-univers (étape 2b).
  universeId String

  @@index([userId])
  @@index([universeId, userId])
}

/// Partie « JJK Codenames » — état autoritatif d'une partie d'équipe (2 équipes,
/// 4-6 joueurs) en cours. Réutilise le lobby/présence Pusher (Lobby via lobbyId).
/// La carte-clé (`colorKey`, mapping id→couleur) vit ICI et n'est JAMAIS sérialisée
/// vers le client tant que la partie est ACTIVE (anti-triche) : seuls les 2 maîtres-
/// espions la récupèrent via une Server Action authentifiée. La grille (36 IDs) est
/// partagée/identique pour tous. La sélection d'équipe pré-partie vit dans
/// `Lobby.gameState` (phase transitoire), pas ici : `teams` est figé au démarrage.
model CodenamesGame {
  id                String   @id @default(cuid())
  lobbyId           String   @unique
  gridCharIds       String[] // 36 IDs (6×6), ordre partagé
  colorKey          Json // { [charId]: "RED"|"PURPLE"|"NEUTRAL"|"ASSASSIN" } — jamais diffusée en ACTIVE
  redSpymasterId    String
  purpleSpymasterId String
  teams             Json // { [userId]: "RED"|"PURPLE" } figé au démarrage
  revealedIds       String[] @default([])
  redScore          Int      @default(0)
  purpleScore       Int      @default(0)
  currentTeam       String // "RED" | "PURPLE"
  currentClue       Json? // { word: string, count: number, remaining: number }
  passedAgentIds    String[] @default([]) // agents ayant "passé" ce tour (reset à chaque tour)
  status            String   @default("ACTIVE") // ACTIVE | FINISHED
  winnerTeam        String? // "RED" | "PURPLE"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Multi-univers (étape 2e), même raisonnement que GuessWhoGame.
  universeId String

  @@index([lobbyId])
}

/// Résultat d'une partie « JJK Codenames » — une ligne PAR joueur ET PAR partie
/// terminée (append). `won` = ce joueur a gagné. Le ratio V/D se lit par agrégation.
model CodenamesScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  won       Boolean
  team      String // "RED" | "PURPLE"
  createdAt DateTime @default(now())

  // Multi-univers (étape 2b).
  universeId String

  @@index([userId])
  @@index([universeId, userId])
}

/// Meilleur score d'un utilisateur pour un jeu donné (un enregistrement par
/// couple utilisateur/jeu — upsert quand un nouveau record est battu).
model Score {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  best      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-univers (étape 2b). Colonne scalaire (pas de FK) pour ces tables
  // append/upsert à fort volume. Classements filtrés par univers à la lecture.
  universeId String

  @@unique([userId, universeId, gameId])
  @@index([universeId, gameId, best])
}

// ──────────────────────────────────────────────────────────────────────────
// Multi-univers (plateforme "anime-arcade"). Un univers = des lignes de CONTENU
// taggées par `universeId` + une config de thème (lib/universes/). L'univers
// courant est résolu par hostname (middleware, cf. étape 4). La config vit en
// code (lib/universes/registry.ts), joint la base par `slug`.
// ──────────────────────────────────────────────────────────────────────────

/// Univers (anime) de la plateforme. `slug` = clé stable jointe à la config
/// code (ex. "jjk", "csm"). Le contenu et les scores sont filtrés par `id`.
model Universe {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  characters        Character[]
  categories        Category[]
  draftCharacters   DraftCharacter[]
  rankingConditions RankingCondition[]
  userProfiles      UserUniverseProfile[]
  attributes        Attribute[]
}

// ──────────────────────────────────────────────────────────────────────────
// Attributs DATA-DRIVEN (étape 3). Remplacent les enums Jjk* : chaque univers
// définit SES propres attributs de personnage, donc JJKdle fonctionne pour
// n'importe quel anime sans une ligne de code métier en plus.
//
// Les enums Jjk* et les colonnes correspondantes de `Character` sont CONSERVÉS
// le temps du strangler (parité prouvée par lib/games/jjkdle/scoring.parity.test.ts),
// puis supprimés.
// ──────────────────────────────────────────────────────────────────────────

/// Nature d'un attribut — détermine la comparaison et le rendu du formulaire admin.
enum AttributeKind {
  /// Liste fermée non ordonnée (race, genre…) : égalité stricte, jamais de flèche.
  CATEGORICAL
  /// Liste fermée ORDONNÉE (grade, arc…) : indice ↑/↓ via `AttributeOption.order`.
  ORDINAL
  /// Oui/Non. Stocké comme un CATEGORICAL à 2 options ("true"/"false") — une
  /// seule voie de stockage, et les libellés Oui/Non restent de la donnée.
  BOOLEAN
  /// Entier (énergie occulte…) : indice ↑/↓ + palier « proche » via `tolerance`.
  NUMERIC
}

/// Attribut de personnage propre à un univers (une colonne de la grille JJKdle).
model Attribute {
  id         String        @id @default(cuid())
  universeId String
  universe   Universe      @relation(fields: [universeId], references: [id])
  /// Clé stable et lisible ("grade", "appearanceArc", "cursedEnergy").
  key        String
  /// Libellé affiché en en-tête de colonne ("Grade", "Énergie occulte").
  label      String
  kind       AttributeKind
  /// Ordre d'affichage des colonnes de la grille.
  position   Int           @default(0)
  /// ORDINAL/NUMERIC : l'indice affiche une flèche ↑/↓.
  comparable Boolean       @default(false)
  /// NUMERIC uniquement : écart |cible − proposition| sous lequel l'indice passe
  /// en « proche » (orange). JJK cursedEnergy = 20 (ex-CURSED_ENERGY_TOLERANCE).
  tolerance  Int?

  options AttributeOption[]
  values  CharacterAttribute[]

  @@unique([universeId, key])
  @@index([universeId, position])
}

/// Valeur possible d'un attribut à liste fermée (CATEGORICAL/ORDINAL/BOOLEAN).
model AttributeOption {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  /// Valeur stable stockée/comparée ("GRADE_1", "true").
  value       String
  /// Libellé affiché ("Grade 1", "Oui").
  label       String
  /// Rang pour l'indice ↑/↓ des attributs ORDINAL.
  /// NULL = valeur NON ORDONNÉE → jamais de flèche. C'est ce qui reproduit la
  /// règle historique de `NO_GRADE` (« pas de grade » ne se compare pas à un grade).
  order       Int?

  values CharacterAttribute[]

  @@unique([attributeId, value])
}

/// Valeur d'un attribut pour un personnage. L'ABSENCE de ligne = « non renseigné »
/// (ce qui rend le perso inéligible comme cible du jour, cf. isComplete).
model CharacterAttribute {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  /// CATEGORICAL | ORDINAL | BOOLEAN.
  optionId     String?
  option       AttributeOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// NUMERIC.
  numericValue Int?

  @@unique([characterId, attributeId])
  @@index([attributeId, optionId])
}

// ──────────────────────────────────────────────────────────────────────────
// Contenu du jeu (anciennement dans data/). Source de vérité = la base ;
// les fichiers data/ ne servent plus qu'au typage et au seed initial.
// ──────────────────────────────────────────────────────────────────────────

/// Catégorie de stats du builder ("Build the Perfect Sorcerer").
/// `id` = CategoryId (ex. "innate-technique").
model Category {
  id          String @id
  label       String
  description String
  weight      Float
  drawCount   Int
  position    Int    @default(0)

  // Multi-univers (étape 2a). `id` reste la PK globale ; `slug` = clé lisible
  // unique PAR univers (JJK : slug = id, ex. "innate-technique").
  slug       String
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id])

  @@unique([universeId, slug])
  @@index([universeId, position])
}

/// Personnage du roster. `ratings` est un objet JSON
/// { [categoryId]: note 0-100 } — la présence d'une clé = éligible à la catégorie.
model Character {
  id        String  @id
  name      String
  title     String
  tier      String
  /// URL d'affichage : chemin statique (/assets/...) OU route API d'une image uploadée.
  image     String?
  /// Image uploadée via /admin (binaire en base, servie par /api/characters/[id]/image).
  imageData Bytes?
  imageMime String?
  ratings   Json
  /// Score de combat pour le jeu "JJK Random Battle" (cumul de fin de partie).
  /// Optionnel : le builder l'ignore ; fallback 30 côté battle si null.
  battleValue Int?
  position  Int     @default(0)


  // ── Multi-univers (étape 1, phase B : NON-NULL après backfill).
  // `id` reste la PK globale (zéro cassure des références string existantes) ;
  // `slug` = clé lisible unique PAR univers (JJK : slug = id, ex. "gojo").
  slug       String
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id])

  /// Avatars par univers (UserUniverseProfile) pointant sur ce personnage.
  universeAvatarUsers UserUniverseProfile[] @relation("UserUniverseAvatar")

  /// Valeurs d'attributs data-driven (étape 3). Remplacent à terme les colonnes
  /// enum ci-dessus. Absence de ligne pour un attribut = « non renseigné ».
  attributeValues CharacterAttribute[]

  @@unique([universeId, slug])
  @@index([universeId, position])
  @@index([position])
}

/// Personnage du jeu "Jujutsu Draft" (roster propre, éditable depuis /admin).
/// `excellenceCategory` et `tier` sont des chaînes validées côté action.
model DraftCharacter {
  id                 String  @id
  name               String
  /// URL d'affichage : chemin statique (/assets/...) OU route API d'une image uploadée.
  image              String?
  /// Image uploadée via /admin (binaire en base, servie par /api/draft-characters/[id]/image).
  imageData          Bytes?
  imageMime          String?
  excellenceCategory String
  tier               String
  cost               Int
  statValue          Int
  position           Int     @default(0)

  // Multi-univers (étape 2a). `id` reste la PK globale ; `slug` = clé lisible
  // unique PAR univers (JJK : slug = id).
  slug       String
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id])

  @@unique([universeId, slug])
  @@index([universeId, position])
  @@index([position])
}

/// Consigne du jeu "JJK Pyramid" : `order` = 8 IDs de personnages, rang 1→8.
/// `pool` = thème/casting (axe « qui »), `category` = critère (axe « selon quoi »).
model RankingCondition {
  id       String   @id
  pool     String   @default("")
  category String
  prompt   String
  order    String[]
  position Int      @default(0)

  /// `Category.id` dont ce classement est DÉRIVÉ (consigne générée par le bouton
  /// « Importer les catégories »). `null` = consigne écrite à la main, dont
  /// `order` fait foi. Pour une dérivée, `order` n'est qu'un cache : le vrai
  /// classement est recalculé depuis les notes du roster à chaque lecture, si
  /// bien qu'un rééquilibrage se répercute sans réimport.
  criterion String?

  /// Arbitrage d'ÉGALITÉS, rang 1→8 : ordre choisi à la main dans l'admin,
  /// appliqué UNIQUEMENT entre personnages de note identique. Une note tranche
  /// toujours avant lui — c'est ce qui permet à cet arbitrage de survivre à une
  /// modification de notes sans jamais la contredire.
  tiebreak String[]

  // Multi-univers (étape 2a). `id` reste la PK globale ; `slug` = clé lisible
  // unique PAR univers (JJK : slug = id).
  slug       String
  universeId String
  universe   Universe @relation(fields: [universeId], references: [id])

  @@unique([universeId, slug])
  @@index([universeId, position])
  @@index([position])
}

// ──────────────────────────────────────────────────────────────────────────
// Multijoueur — lobbys privés (builder uniquement pour l'instant).
//
// Le serveur est autoritatif : l'état de chaque partie vit ici, les Server
// Actions le mutent puis déclenchent un événement Pusher rebroadcasté au lobby.
// ──────────────────────────────────────────────────────────────────────────

/// Cycle de vie d'un lobby.
enum LobbyStatus {
  WAITING // salon d'attente, on peut encore rejoindre
  PLAYING // partie en cours (synchronisation lockstep par manche)
  FINISHED // partie terminée, récap affiché
}

/// Lobby privé (partie multijoueur). `code` = code court partageable.
model Lobby {
  id         String      @id @default(cuid())
  code       String      @unique
  gameId     String      @default("builder")
  hostId     String
  status     LobbyStatus @default(WAITING)
  /// Manche courante (0-indexée) : nombre de catégories déjà verrouillées par joueur.
  roundIndex Int         @default(0)
  /// État de jeu autoritatif pour les modes hors builder (ex. "JJK Random Battle").
  /// Blob JSON spécifique au gameId ; vide ({}) pour le builder.
  gameState  Json        @default("{}")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  players LobbyPlayer[]

  // Multi-univers (étape 2e). `code` reste GLOBALEMENT unique (deux univers ne
  // peuvent pas tirer le même code) ; en revanche la RÉSOLUTION par code filtre
  // sur l'univers courant → un code d'un autre univers se comporte exactement
  // comme un code inexistant.
  universeId String

  @@index([code])
  @@index([universeId])
}

/// Plateau d'un joueur dans un lobby (sa sélection verrouillée + son tirage courant).
model LobbyPlayer {
  id              String  @id @default(cuid())
  lobbyId         String
  lobby           Lobby   @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ordre d'arrivée (l'hôte = 0) — sert au tri d'affichage.
  joinOrder       Int
  /// Sélection verrouillée : { [categoryId]: characterId }.
  selection       Json    @default("{}")
  /// Tirage courant proposé à ce joueur : { [categoryId]: characterId | null }.
  currentDraw     Json    @default("{}")
  /// A verrouillé une catégorie pour la manche en cours (lockstep).
  lockedThisRound Boolean @default(false)
  /// Score final (calculé à la fin via evaluateBuild).
  finalScore      Int?

  @@unique([lobbyId, userId])
  @@index([lobbyId])
}
