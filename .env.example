# ──────────────────────────────────────────────────────────────────────────
# Variables d'environnement — JJK Arcade
# ──────────────────────────────────────────────────────────────────────────
# Copie ce fichier en `.env` (non commité) et renseigne les valeurs.

# URL publique du site (sans slash final) — sert au SEO : URLs canoniques,
# aperçus Open Graph/Twitter, sitemap, robots et données structurées JSON-LD.
# Mets l'URL Vercel pour l'instant, puis le domaine custom quand il existera.
# Sans cette variable, les URLs SEO retombent sur un fallback (aperçus cassés).
NEXT_PUBLIC_SITE_URL="https://jjkdle-arcade.vercel.app"

# ──────────────────────────────────────────────────────────────────────────
# MULTI-UNIVERS
# ──────────────────────────────────────────────────────────────────────────

# L'univers vient du PREMIER SEGMENT de l'URL — un seul domaine sert tout :
#   /              → hub (choix de l'univers)
#   /jjk/games     → univers JJK
#   /csm/games     → univers CSM
# Rien à configurer pour le hub : il vit à la racine, sur n'importe quel domaine.

# Univers de repli quand l'URL n'en désigne aucun (ex. un lien qui aurait oublié
# son préfixe, avant redirection). Slug d'un univers du registre. Défaut : jjk.
DEFAULT_UNIVERSE="jjk"

# Domaine du cookie de session. Inutile en routage par préfixe (une seule
# origine ⇒ session partagée d'office). À ne renseigner que si les univers
# passaient un jour sur des SOUS-DOMAINES d'un même apex (ex. ".apex.com").
SESSION_COOKIE_DOMAIN=""

# Code de vérification Google Search Console (méthode « balise HTML »).
# Colle uniquement la valeur du content="..." (pas la balise entière). Optionnel.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Base de données Neon (Postgres) — requise pour l'auth et le leaderboard.
# Crée un projet sur https://neon.tech puis copie la connection string ici.
# Applique le schéma avec :  npm run db:push   (puis npm run db:generate)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Comptes promus automatiquement en rôle ADMIN (emails séparés par des virgules).
# Un utilisateur qui s'inscrit / se connecte avec un de ces emails devient ADMIN
# et accède à /admin (édition du roster).
ADMIN_EMAILS="admin@example.com"


# ──────────────────────────────────────────────────────────────────────────
# Pusher Channels — requis pour le mode multijoueur en temps réel.
# Crée une app gratuite sur https://pusher.com (Channels) puis copie les clés.
# APP_ID et SECRET restent côté serveur ; KEY et CLUSTER sont exposés au client
# (préfixe NEXT_PUBLIC_). Sans ces variables, seul le mode multijoueur est
# désactivé — le reste de l'app fonctionne normalement.
PUSHER_APP_ID="123456"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ──────────────────────────────────────────────────────────────────────────
# API booru — récupération auto des images de perso (bouton « OUAIS » dans /admin).
# URL de base de l'endpoint posts, SANS &tags=... (ajouté automatiquement).
# Optionnel : sans cette variable, le bouton « OUAIS » renvoie une erreur.
BOORU_API_BASE="https://example.booru/index.php?page=dapi&s=post&q=index"
# Clés d'API si le booru les exige (rule34.xxx les rend obligatoires).
BOORU_API_KEY=""
BOORU_USER_ID=""
# Tag de série ajouté à chaque requête (optionnel, défaut : jujutsu_kaisen).
BOORU_SERIES_TAG="jujutsu_kaisen"
# Délai (ms) entre deux appels API pour respecter la limite par seconde (déf. 300).
BOORU_REQUEST_DELAY_MS="300"

# ──────────────────────────────────────────────────────────────────────────
# MAILS — formulaire de contact (footer) + notifications d'administration
# (nouvel inscrit, erreur serveur, jeu ON/OFF, maintenance, casino, rôles,
# univers) + résumé quotidien. Envoi via Gmail SMTP (nodemailer).
#
# SMTP_PASS n'est PAS le mot de passe du compte Google mais un « mot de passe
# d'application » : compte Google → Sécurité → activer la validation en 2 étapes
# → « Mots de passe des applications » → en créer un (16 caractères).
# Sans ces deux variables, aucun mail ne part (simple avertissement en log) et
# le formulaire de contact archive le message en base (table ContactMessage).
SMTP_USER=anime.arcadeidle@gmail.com
SMTP_PASS=

# Destinataire des notifications et des messages de contact.
# Défaut : anime.arcadeidle@gmail.com
ADMIN_NOTIFY_EMAIL=

# Secret du cron quotidien (/api/cron/daily-digest, cf. vercel.json). Vercel
# l'envoie automatiquement en « Authorization: Bearer … » quand la variable
# existe dans le projet. Génère une valeur longue et aléatoire.
CRON_SECRET=

# Alertes d'erreur serveur : envoyées en production uniquement. Mets 1 pour les
# tester en local (npm run dev).
NOTIFY_IN_DEV=
